    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lucide/angular": "^1.72.0",
