{
  "$comment": "Hey Payments design tokens. Source of truth for frontend/src/styles/tokens.scss. All text pairs verified >= 4.5:1, UI borders >= 3:1 (WCAG 2.2 AA).",
  "color": {
    "light": {
      "bg": "#F7F5F0", "surface": "#FFFFFF", "surface-alt": "#EFEBE3",
      "ink": "#0E1B2C", "ink-muted": "#4A5568", "border": "#6B7280", "divider": "#E2DED5",
      "primary": "#0F766E", "on-primary": "#FFFFFF", "primary-soft": "#CCFBF1",
      "accent": "#F5A524", "on-accent": "#0E1B2C",
      "status-offline": "#4338CA", "status-pending": "#B45309", "status-settled": "#15803D", "status-failed": "#B91C1C",
      "focus": "#2563EB"
    },
    "dark": {
      "bg": "#0B1420", "surface": "#132033", "surface-alt": "#1B2A40",
      "ink": "#E8EEF5", "ink-muted": "#94A3B8", "border": "#64748B", "divider": "#22324A",
      "primary": "#2DD4BF", "on-primary": "#0B1420", "primary-soft": "#134E4A",
      "accent": "#F5A524", "on-accent": "#0E1B2C",
      "status-offline": "#A5B4FC", "status-pending": "#FBBF24", "status-settled": "#4ADE80", "status-failed": "#F87171",
      "focus": "#93C5FD"
    }
  },
  "font": {
    "family": { "display": "'Space Grotesk', system-ui, sans-serif", "body": "'Inter', 'Noto Sans Devanagari', system-ui, sans-serif", "mono": "'JetBrains Mono', ui-monospace, monospace" },
    "scale-rem": { "display": 2.5, "h1": 2.0, "h2": 1.5, "h3": 1.25, "body-lg": 1.125, "body": 1.0, "caption": 0.875, "overline": 0.75 },
    "amount-hero-rem": 3.0,
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "line-height": { "tight": 1.15, "normal": 1.5 }
  },
  "space-px": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius-px": { "sm": 8, "md": 12, "lg": 20, "pill": 999 },
  "elevation": { "1": "0 1px 2px rgba(14,27,44,.08)", "2": "0 4px 12px rgba(14,27,44,.10)", "3": "0 12px 32px rgba(14,27,44,.16)" },
  "motion": {
    "duration-ms": { "instant": 100, "fast": 160, "base": 240, "slow": 400, "success": 600 },
    "easing": { "standard": "cubic-bezier(.2,0,0,1)", "enter": "cubic-bezier(0,0,0,1)", "exit": "cubic-bezier(.3,0,1,1)" },
    "reduced-motion": "durations -> 0, replace scale/confetti with opacity fade"
  },
  "touch-target-min-px": 44,
  "breakpoints-px": { "phone": 360, "phone-lg": 430, "tablet": 768, "desktop": 1200 }
}
